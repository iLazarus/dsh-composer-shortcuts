{
  "name": "dsh-composer-shortcuts",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Left-sidebar settings page for custom send and line-break keys in the DeepSeek Harness composer.",
  "license": "MIT",
  "author": "iLazarus (https://github.com/iLazarus)",
  "homepage": "https://github.com/iLazarus/dsh-composer-shortcuts#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iLazarus/dsh-composer-shortcuts.git"
  },
  "bugs": {
    "url": "https://github.com/iLazarus/dsh-composer-shortcuts/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cordis",
    "composer",
    "keybinding",
    "shortcut",
    "enter",
    "newline",
    "sidebar"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node test.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  }
}
